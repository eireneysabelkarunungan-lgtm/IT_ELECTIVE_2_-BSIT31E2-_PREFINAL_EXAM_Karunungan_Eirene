@model List<IT_ELECTIVE_2_PREFINAL_Karunungan_Eirene.Models.Question>

@{
    ViewData["Title"] = "Exam Answers";
}

<div class="exam-shell">
    <div class="exam-card">
        <div class="eyebrow">IT ELECTIVE 2 &middot; PREFINAL EXAM</div>
        <h1 class="exam-heading">Exam Answers</h1>
        <p class="exam-subtitle">Eirene Ysabel Karunungan &bull; BSIT31E2</p>

        <span class="field-label">Questions (@Model.Count / 20)</span>

        @foreach (var q in Model)
        {
            <a class="question-list-row" asp-action="Details" asp-route-id="@q.Number">
                <span><span class="q-number">Q@(q.Number)</span>@q.Text</span>
                <span>&rarr;</span>
            </a>
        }

        @if (!Model.Any())
        {
            <p class="exam-subtitle">No questions added yet.</p>
        }
    </div>
</div>