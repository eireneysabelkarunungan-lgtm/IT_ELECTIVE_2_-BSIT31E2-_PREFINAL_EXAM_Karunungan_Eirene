@model IT_ELECTIVE_2_PREFINAL_Karunungan_Eirene.Models.Question

@{
    ViewData["Title"] = $"Question {Model.Number}";
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to all questions</a>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Question @Model.Number</h4>
    </div>
    <div class="card-body">
        <p class="fs-5">@Model.Text</p>

        <ul class="list-group mb-3">
            @foreach (var opt in Model.Options)
            {
                var isCorrect = opt.Key == Model.CorrectAnswer;
                <li class="list-group-item @(isCorrect ? "list-group-item-success fw-bold" : "")">
                    @opt.Key. @opt.Value
                    @if (isCorrect)
                    {
                        <span class="badge bg-success float-end">Correct Answer</span>
                    }
                </li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(Model.Explanation))
        {
            <div class="alert alert-info">
                <strong>Explanation:</strong> @Model.Explanation
            </div>
        }
    </div>
</div>