@model IT_ELECTIVE_2_PREFINAL_Karunungan_Eirene.Models.Question

@{
    ViewData["Title"] = $"Question {Model.Number}";
}

<div class="exam-shell">
    <div class="exam-card">
        <div class="eyebrow">IT ELECTIVE 2 &middot; PREFINAL EXAM &middot; QUESTION @Model.Number</div>
        <h1 class="exam-heading">Question @Model.Number</h1>
        <p class="exam-subtitle">@Model.Text</p>

        <span class="field-label">Options</span>
        @foreach (var opt in Model.Options)
        {
            var isCorrect = opt.Key == Model.CorrectAnswer;
            <div class="option-row @(isCorrect ? "correct" : "")">
                @opt.Key. @opt.Value
                @if (isCorrect)
                {
                    <span class="badge-answer">My Answer</span>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Explanation))
        {
            <p class="exam-subtitle" style="margin-top: 20px;">@Model.Explanation</p>
        }

        <a class="btn-exam" asp-action="Index" style="margin-top: 12px;">&larr; Back to all questions</a>
    </div>
</div>